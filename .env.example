# 小米 MiMo API
MIMO_API_KEY=your_mimo_api_key
MIMO_BASE_URL=https://api.xiaomimimo.com/v1
MIMO_LLM_MODEL=mimo-v2.5-pro
MIMO_TTS_MODEL=mimo-v2.5-tts

# 火山引擎（视频/图片功能，可选）
VOLCENGINE_ACCESS_KEY=your_volcengine_access_key
VOLCENGINE_SECRET_KEY=your_volcengine_secret_key

# MySQL
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/ai_agent?charset=utf8mb4

# Redis
REDIS_URL=redis://localhost:6379/0

# 文件存储
STORAGE_PATH=./storage

# 应用配置
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true
